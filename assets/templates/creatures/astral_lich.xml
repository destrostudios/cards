<template>
    <values>
        <damage>1</damage>
    </values>
    <entity template="./templates/vanilla(name=Astral Lich,manaCost=4,attack=2,health=4)">
        <description>After a creature is healed, deal [damage] damage to all opponent creatures.</description>
        <postHealTriggers>
            <entity>
                <sourcePrefilters basic="CREATURE_ZONE"/>
                <targetPrefilters basic="CREATURE_ZONE"/>
                <effects>
                    <entity template="../effects/damage_all_opponent_creatures(damage=[damage])"/>
                </effects>
            </entity>
        </postHealTriggers>
    </entity>
</template>