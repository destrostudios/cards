<template>
    <values>
        <manaGain>1</manaGain>
    </values>
    <entity id="card">
        <name>Unprocessed Mana Crystal</name>
        <spellCard/>
        <description>Gain [manaGain] mana.</description>
        <spells>
            <entity>
                <source>#card</source>
                <sourcePrefilters basic="HAND"/>
                <manaCost>0</manaCost>
                <castTriggers>
                    <entity>
                        <effects>
                            <entity template="../effects/move_source_to_graveyard"/>
                            <entity template="../effects/gain_mana_for_source_owner(mana=[manaGain])"/>
                        </effects>
                    </entity>
                </castTriggers>
            </entity>
        </spells>
    </entity>
</template>